{
  "info": {
    "_postman_id": "4ca20bc7-b2e5-47e8-b00c-17412f2a8dbc",
    "name": "NILEX Authentication API",
    "description": "Phase 4 authentication flow. Run requests in order. Access and refresh tokens are captured into runtime collection variables and are not stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "name", "value": "NILEX Postman User" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "postman-demo-password" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "previousRefreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Complete Authentication Flow",
      "item": [
        {
          "name": "1. Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `nilex.postman.${Date.now()}@example.invalid`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "pm.test('No sensitive fields', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).not.to.have.property('password');",
                  "  pm.expect(json).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged in', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.test('Token lifetimes are correct', () => {",
                  "  pm.expect(json.expiresIn).to.eql(1800);",
                  "  pm.expect(json.refreshExpiresIn).to.eql(2592000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "3. Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile returned', () => pm.response.to.have.status(200));",
                  "pm.test('Profile is safe', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(json).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "4. Refresh and Rotate Tokens",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('previousRefreshToken', pm.collectionVariables.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tokens rotated', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.refreshToken).not.to.eql(pm.collectionVariables.get('previousRefreshToken'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "5. Profile with Refreshed Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Refreshed access token works', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "6. Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Logged out', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Common Error Cases",
      "item": [
        {
          "name": "Duplicate Registration - 409",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Conflict', () => pm.response.to.have.status(409));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Invalid Registration - 400",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Validation error', () => pm.response.to.have.status(400));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Wrong Password - 401",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Unauthorized', () => pm.response.to.have.status(401));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Reused Refresh Token - 401",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Replay rejected', () => pm.response.to.have.status(401));"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{previousRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Missing JWT on Profile - 401",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Unauthorized', () => pm.response.to.have.status(401));"] }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Revoked Access Token after Logout - 401",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Revoked session rejected', () => pm.response.to.have.status(401));"] }
          }],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        }
      ]
    }
  ]
}
